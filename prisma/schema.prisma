generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, citext]
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum PlatformRole {
  BUYER
  DEVELOPER_MEMBER
  BROKER
  ADMIN
  SUPER_ADMIN
}

enum OrganizationType {
  DEVELOPER
  BROKER_AGENCY
  PLATFORM
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

enum PreferredLanguage {
  TR
  EN
  AR
  RU
}

enum ConstructionStatus {
  PLANNED
  UNDER_CONSTRUCTION
  READY
}

model User {
  id                   String                   @id @default(uuid()) @db.Uuid
  email                String                   @unique @db.Citext
  passwordHash         String                   @map("password_hash")
  status               UserStatus               @default(ACTIVE)
  fullName             String?                  @map("full_name") @db.VarChar(160)
  phone                String?                  @db.VarChar(16)
  preferredLanguage    PreferredLanguage?       @map("preferred_language")
  preferredCurrency    String?                  @map("preferred_currency") @db.Char(3)
  securityVersion      Int                      @default(1) @map("security_version")
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles                UserPlatformRole[]
  memberships          OrganizationMembership[]
  sessions             AuthSession[]
  auditLogs            AuditLog[]               @relation("AuditActor")
  leads                Lead[]
  savedProjects        SavedProject[]
  brokerClientsCreated BrokerClient[]           @relation("BrokerClientCreator")

  @@map("users")
}

model UserPlatformRole {
  userId    String       @map("user_id") @db.Uuid
  role      PlatformRole
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
  @@map("user_platform_roles")
}

model Organization {
  id            String                   @id @default(uuid()) @db.Uuid
  name          String                   @db.VarChar(200)
  slug          String                   @unique @db.VarChar(200)
  type          OrganizationType
  status        OrganizationStatus       @default(ACTIVE)
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships   OrganizationMembership[]
  projects      Project[]
  auditLogs     AuditLog[]
  verifiedAt    DateTime?                @map("verified_at") @db.Timestamptz(3)
  about         String?                  @db.Text
  logoUrl       String?                  @map("logo_url") @db.VarChar(1000)
  salesEmail    String?                  @map("sales_email") @db.Citext
  salesPhone    String?                  @map("sales_phone") @db.VarChar(16)
  websiteUrl    String?                  @map("website_url") @db.VarChar(1000)
  version       Int                      @default(1)
  brokerClients BrokerClient[]

  @@index([type, status])
  @@map("organizations")
}

model OrganizationMembership {
  userId         String         @map("user_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  role           MembershipRole
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId, role])
  @@map("organization_memberships")
}

model AuthSession {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  expiresAt         DateTime       @map("expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime       @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?      @map("revoked_at") @db.Timestamptz(3)
  compromisedAt     DateTime?      @map("compromised_at") @db.Timestamptz(3)
  userAgent         String?        @map("user_agent") @db.VarChar(500)
  ipAddress         String?        @map("ip_address") @db.Inet
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens     RefreshToken[]

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @map("session_id") @db.Uuid
  tokenHash String      @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime    @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?   @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime?   @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("refresh_tokens")
}

model Province {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @unique @db.VarChar(32)
  name      String     @db.VarChar(100)
  slug      String     @unique @db.VarChar(100)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  districts District[]
  projects  Project[]

  @@map("provinces")
}

model District {
  id         String    @id @default(uuid()) @db.Uuid
  provinceId String    @map("province_id") @db.Uuid
  code       String    @unique @db.VarChar(32)
  name       String    @db.VarChar(100)
  slug       String    @db.VarChar(100)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  province   Province  @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  projects   Project[]

  @@unique([provinceId, slug])
  @@unique([id, provinceId])
  @@index([provinceId, name])
  @@map("districts")
}

model Project {
  id                      String                               @id @default(uuid()) @db.Uuid
  developerOrganizationId String                               @map("developer_organization_id") @db.Uuid
  name                    String                               @db.VarChar(200)
  slug                    String                               @unique @db.VarChar(200)
  status                  ProjectStatus                        @default(DRAFT)
  provinceId              String                               @map("province_id") @db.Uuid
  districtId              String                               @map("district_id") @db.Uuid
  latitude                Decimal                              @db.Decimal(9, 6)
  longitude               Decimal                              @db.Decimal(9, 6)
  location                Unsupported("geometry(Point,4326)")?
  startingPrice           Decimal                              @map("starting_price") @db.Decimal(19, 4)
  currency                String                               @db.Char(3)
  deliveryDate            DateTime?                            @map("delivery_date") @db.Date
  summary                 String?                              @db.Text
  heroImageUrl            String?                              @map("hero_image_url") @db.VarChar(1000)
  stockUpdatedAt          DateTime?                            @map("stock_updated_at") @db.Timestamptz(3)
  priceUpdatedAt          DateTime?                            @map("price_updated_at") @db.Timestamptz(3)
  createdAt               DateTime                             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(3)
  version                 Int                                  @default(1)
  developerOrganization   Organization                         @relation(fields: [developerOrganizationId], references: [id], onDelete: Restrict)
  province                Province                             @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  district                District                             @relation(fields: [districtId, provinceId], references: [id, provinceId], onDelete: Restrict)
  units                   Unit[]
  paymentPlans            PaymentPlan[]
  leads                   Lead[]
  savedBy                 SavedProject[]
  brokerOffer             BrokerOffer?
  materials               ProjectMaterial[]
  media                   ProjectMedia[]
  engagementDaily         ProjectEngagementDaily[]
  amenities               ProjectAmenity[]
  pointsOfInterest        ProjectPointOfInterest[]
  constructionStatus      ConstructionStatus                   @default(PLANNED) @map("construction_status")

  @@index([status, createdAt])
  @@index([provinceId, districtId, status])
  @@index([developerOrganizationId, status])
  @@map("projects")
}

model Unit {
  id                String          @id @default(uuid()) @db.Uuid
  projectId         String          @map("project_id") @db.Uuid
  unitNumber        String          @map("unit_number") @db.VarChar(80)
  block             String?         @db.VarChar(80)
  floor             Int?
  roomType          String          @map("room_type") @db.VarChar(40)
  netArea           Decimal         @map("net_area") @db.Decimal(10, 2)
  grossArea         Decimal?        @map("gross_area") @db.Decimal(10, 2)
  price             Decimal         @db.Decimal(19, 4)
  currency          String          @db.Char(3)
  status            UnitStatus      @default(AVAILABLE)
  orientation       String?         @db.VarChar(40)
  floorPlanImageUrl String?         @map("floor_plan_image_url") @db.VarChar(1000)
  version           Int             @default(1)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brokerTerm        BrokerUnitTerm?

  @@unique([projectId, unitNumber])
  @@index([projectId, status, roomType])
  @@map("units")
}

model PaymentPlan {
  id                  String   @id @default(uuid()) @db.Uuid
  projectId           String   @map("project_id") @db.Uuid
  name                String   @db.VarChar(120)
  downPaymentPercent  Decimal  @map("down_payment_percent") @db.Decimal(5, 2)
  termMonths          Int      @map("term_months")
  deliveryPercent     Decimal  @default(0) @map("delivery_percent") @db.Decimal(5, 2)
  isRecommended       Boolean  @default(false) @map("is_recommended")
  monthlyPayment      Decimal? @map("monthly_payment") @db.Decimal(19, 4)
  totalPrice          Decimal? @map("total_price") @db.Decimal(19, 4)
  cashDiscountPercent Decimal? @map("cash_discount_percent") @db.Decimal(5, 2)
  timelineNote        String?  @map("timeline_note") @db.VarChar(500)
  version             Int      @default(1)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
  @@map("payment_plans")
}

model Lead {
  id                String            @id @default(uuid()) @db.Uuid
  projectId         String            @map("project_id") @db.Uuid
  buyerUserId       String            @map("buyer_user_id") @db.Uuid
  idempotencyKey    String            @map("idempotency_key") @db.VarChar(100)
  requestHash       String            @map("request_hash") @db.Char(64)
  fullName          String            @map("full_name") @db.VarChar(160)
  phone             String            @db.VarChar(32)
  email             String?           @db.Citext
  preferredLanguage PreferredLanguage @map("preferred_language")
  unitPreference    String?           @map("unit_preference") @db.VarChar(40)
  budgetMin         Decimal?          @map("budget_min") @db.Decimal(19, 4)
  budgetMax         Decimal?          @map("budget_max") @db.Decimal(19, 4)
  currency          String            @default("TRY") @db.Char(3)
  consentVersion    String            @map("consent_version") @db.VarChar(50)
  consentedAt       DateTime          @map("consented_at") @db.Timestamptz(3)
  status            LeadStatus        @default(NEW)
  closedReason      String?           @map("closed_reason") @db.VarChar(240)
  version           Int               @default(1)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  buyer             User              @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)

  @@unique([buyerUserId, projectId, idempotencyKey])
  @@index([projectId, status, createdAt])
  @@map("leads")
}

model SavedProject {
  userId    String   @map("user_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@map("saved_projects")
}

model BrokerOffer {
  projectId         String   @id @map("project_id") @db.Uuid
  enabled           Boolean  @default(false)
  brokerPrice       Decimal? @map("broker_price") @db.Decimal(19, 4)
  commissionPercent Decimal? @map("commission_percent") @db.Decimal(5, 2)
  reservationHours  Int?     @map("reservation_hours")
  salesContact      String?  @map("sales_contact") @db.VarChar(200)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([enabled, updatedAt])
  @@map("broker_offers")
}

model ProjectMaterial {
  id            String            @id @default(uuid()) @db.Uuid
  projectId     String            @map("project_id") @db.Uuid
  title         String            @db.VarChar(160)
  kind          String            @db.VarChar(40)
  downloadUrl   String            @map("download_url") @db.VarChar(1000)
  language      PreferredLanguage @default(TR)
  versionLabel  String            @default("1") @map("version_label") @db.VarChar(40)
  fileSizeBytes BigInt?           @map("file_size_bytes")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_materials")
}

model BrokerUnitTerm {
  unitId            String   @id @map("unit_id") @db.Uuid
  brokerPrice       Decimal? @map("broker_price") @db.Decimal(19, 4)
  commissionPercent Decimal? @map("commission_percent") @db.Decimal(5, 2)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  unit              Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
  @@map("broker_unit_terms")
}

model ProjectMedia {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  kind          String   @db.VarChar(40)
  url           String   @db.VarChar(1000)
  storageKey    String   @unique @map("storage_key") @db.VarChar(1000)
  mimeType      String   @map("mime_type") @db.VarChar(100)
  fileSizeBytes BigInt   @map("file_size_bytes")
  altText       String?  @map("alt_text") @db.VarChar(240)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version       Int      @default(1)
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder, id])
  @@map("project_media")
}

model MediaDeletion {
  mediaId    String   @id @map("media_id") @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  storageKey String   @map("storage_key") @db.VarChar(1000)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("media_deletions")
}

model ProjectEngagementDaily {
  projectId    String   @map("project_id") @db.Uuid
  date         DateTime @db.Date
  views        Int      @default(0)
  favoriteAdds Int      @default(0) @map("favorite_adds")
  leads        Int      @default(0)
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, date])
  @@index([date, projectId])
  @@map("project_engagement_daily")
}

enum BrokerClientStatus {
  ACTIVE
  ARCHIVED
}

model BrokerClient {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  createdById    String             @map("created_by_id") @db.Uuid
  fullName       String             @map("full_name") @db.VarChar(160)
  phone          String?            @db.VarChar(16)
  email          String?            @db.Citext
  notes          String?            @db.VarChar(2000)
  status         BrokerClientStatus @default(ACTIVE)
  version        Int                @default(1)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      User               @relation("BrokerClientCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, status, updatedAt, id])
  @@map("broker_clients")
}

model ProjectAmenity {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  code      String  @db.VarChar(80)
  label     String  @db.VarChar(160)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, code])
  @@index([code, projectId])
  @@map("project_amenities")
}

model ProjectPointOfInterest {
  id             String  @id @default(uuid()) @db.Uuid
  projectId      String  @map("project_id") @db.Uuid
  name           String  @db.VarChar(160)
  category       String  @db.VarChar(80)
  distanceMeters Int     @map("distance_meters")
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, distanceMeters, id])
  @@map("project_points_of_interest")
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  action         String        @db.VarChar(100)
  entityType     String        @map("entity_type") @db.VarChar(100)
  entityId       String        @map("entity_id") @db.Uuid
  before         Json?
  after          Json?
  requestId      String?       @map("request_id") @db.VarChar(100)
  ipAddress      String?       @map("ip_address") @db.Inet
  userAgent      String?       @map("user_agent") @db.VarChar(500)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}
