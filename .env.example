NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://planda:planda_dev@localhost:5432/planda?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=development-access-secret-change-me-at-least-32-chars
JWT_REFRESH_SECRET=development-refresh-secret-change-me-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=planda-api
JWT_AUDIENCE=planda-clients
AUTH_REFRESH_ROTATION_GRACE_SECONDS=5
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LEAD_CONSENT_CURRENT_VERSION=kvkk-lead-v1
LEAD_CONSENT_APPROVED_VERSIONS=kvkk-lead-v1
ANALYTICS_SESSION_HASH_SECRET=replace-with-at-least-32-random-characters
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=planda-media
STORAGE_ACCESS_KEY=planda
STORAGE_SECRET_KEY=planda-development-secret
STORAGE_PUBLIC_BASE_URL=http://localhost:3001/api/v1/media
STORAGE_FORCE_PATH_STYLE=true
TRUST_PROXY_HOPS=0
RATE_LIMIT_REGISTER_LIMIT=5
RATE_LIMIT_REGISTER_TTL_SECONDS=900
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_TTL_SECONDS=900
RATE_LIMIT_REFRESH_LIMIT=30
RATE_LIMIT_REFRESH_TTL_SECONDS=60
RATE_LIMIT_PUBLIC_LIMIT=120
RATE_LIMIT_PUBLIC_TTL_SECONDS=60
